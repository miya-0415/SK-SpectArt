    "db:studio": "prisma studio --schema=db/schema.prisma"
  },
  "prisma": {
    "schema": "db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.15",
    "prisma": "^5.17.0",
    "tailwindcss": "^3.4.6",
    "typescript": "latest"
  }
